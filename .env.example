# Bard Environment Variables
# Copy to .env and fill in values. DO NOT commit .env

# Application
APP_ENV=development

# Database (async pg URL)
DATABASE_URL=postgresql+psycopg://bard:bard@localhost:5433/bard

# OIDC Authentication
# OIDC_PROVIDER=stub  # "stub" for local dev; real providers later
# OIDC_ISSUER_URL=https://your-provider.com
# OIDC_AUDIENCE=bard-api

# GitHub (for CI/CD automation, not git CLI)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_REPOSITORY=MRBrown91/bard